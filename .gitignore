# Chrome / DevTools artefacts from the screenshot + test harnesses
tools/shots/*.png
.chrome-profile/
.chrome-*/

# Logs and scratch
*.log
tools/*.tmp.js

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# No secrets, no tokens, no credentials belong in this repo.
.env
*.key

# The stable worktree created by play-stable.bat
_stable-play/

# Local Worker dev secrets (see worker/.dev.vars.example; never commit real values)
worker/.dev.vars

# Wrangler local cache (created by \wrangler dev\ from the repo root)
.wrangler/
